.DS_Store
__pycache__/
*.pyc
node_modules/
.venv/

# 同步链路演练产物（CSV/日志，可再生，不入库）
sync/out/
# 计量报表输出目录（metering_report.py 默认输出，可再生不入库）
# 锚定仓库根：不加前导斜杠会连同 docs/reports/ 一起忽略（汇报文档需入库）
/reports/
# testkit 压测/演练产物（生成物，可再生不入库；原被上面未锚定的 reports/ 规则顺带忽略，现显式声明）
testkit/reports/
.env
.pytest_cache/

# TLS 证书（蓝图 1a HTTPS 预留）：自签 dev 证书与生产证书，私钥永不入仓
# dev 证书：certs/dev（自签，随仓分发——陌生人 compose up 免前置生成步骤）
# 其他 certs 路径（如生产证书）仍忽略
/certs/*
!/certs/dev/

# 离线交付打包产物（可再生，不入库）
dist/
docs/architecture/dist/

# 元数据快照导出（卡-1b7 步6；META_SNAPSHOT_DIR 本机开发缺省回落仓内，可再生不入库）
/metadata-snapshots/

