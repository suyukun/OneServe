# OneServe 统一登录 Casdoor 配置【模板】（2026-10-14 Casdoor 集成；2026-10-20 密钥出库批改模板化）
# 本文件含 ${VAR} 环境引用、不含明文凭据；casdoor 容器 entrypoint 先经 render_app_conf.sh
# 把本模板渲染进 tmpfs /conf 再 exec /server（beego 不展开 ${VAR}，2026-10-20 隔离实证）。
# 变量真源＝仓库根 .env（不入仓）；重建行为与出库前完全一致（真值回填口径）。
# 生产改值口径：.env 设 PROD_PUBLIC_ORIGIN（origin/staticBaseUrl 随之派生）＋改 built-in
# admin 口令＋DB 口令走 secret 注入（2026-10-20 部署地址批）。
appname = casdoor
httpport = 8000
runmode = prod
copyrequestbody = true
driverName = postgres
dataSourceName = "user=casdoor password=${CASDOOR_DB_PASSWORD} host=oneserve-casdoor-db port=5432 sslmode=disable dbname=casdoor"
dbName = casdoor
tableNamePrefix =
showSql = false
redisEndpoint =
defaultStorageProvider =
isCloudIntranet = false
authState = "casdoor"
verificationCodeTimeout = 10
initScore = 0
logPostOnly = true
isUsernameLowercased = false
# ADR-0018 同源部署（2026-10-19）：origin=门户统一入口（浏览器与 JWT iss 同口径；
# 门户 nginx 白名单分流→oneserve-casdoor:8000，19000 保持封死）。部署改 PROD_PUBLIC_ORIGIN。
origin = ${PROD_PUBLIC_ORIGIN}
originFrontend =
# built-in admin 首启口令（真值经 CASDOOR_ADMIN_PASSWORD 注入；生产必改）
initAdminPassword = ${CASDOOR_ADMIN_PASSWORD}
# ADR-0018 白标（2026-10-19）：静态基址=门户入口——页脚词图等回源本站，由门户 nginx
# 透明拦截（/img/casdoor-logo* 三文件），杜绝浏览器外联 cdn.casbin.org。
staticBaseUrl = "${PROD_PUBLIC_ORIGIN}"
isDemoMode = false
batchSize = 100
showGithubCorner = false
forceLanguage = ""
defaultLanguage = zh
defaultApplication = app-built-in
maxItemsForFlatMenu = 7
enableErrorMask = false
enableGzip = true
inactiveTimeoutMinutes =
ldapServerPort = 389
quota = {"organization": -1, "user": -1, "application": -1, "provider": -1}
# /data 卷对容器用户不可写（实测 2026-10-14）→ 日志走 /tmp
logConfig = {"adapter":"file", "filename": "/tmp/casdoor.log", "maxdays":7, "perm":"0600"}
initDataNewOnly = false
initDataFile = ""
frontendBaseDir = ""
