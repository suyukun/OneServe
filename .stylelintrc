{
  "extends": [],
  "plugins": [
    "stylelint-declaration-strict-value"
  ],
  "rules": {
    "scale-unlimited/declaration-strict-value": [
      [
        "/color$/",
        "/background(-color)?$/",
        "border-color",
        "outline-color",
        "fill",
        "stroke"
      ],
      {
        "ignoreValues": [
          "#C8102E",
          "#E85B6B",
          "#c8102e",
          "#e85b6b",
          "#009423",
          "#CB272D",
          "#D4760A",
          "#2563eb",
          "#3fb965",
          "#ef6b6b",
          "#e2a03f",
          "#6ea8fe",
          "#cb272d",
          "#d4760a",
          "#5070dd",
          "#505372",
          "#785db0",
          "#0ca8df",
          "#ff994d",
          "#3fbe95",
          "#fb628b",
          "#7b93ec",
          "#ffffff",
          "#fafafa",
          "#f5f5f5",
          "#f0f0f0",
          "#d9d9d9",
          "#bfbfbf",
          "#8c8c8c",
          "#595959",
          "#434343",
          "#262626",
          "#1f1f1f",
          "#141414",
          "#000000",
          "#fff",
          "#000",
          "#12151c",
          "#1a2029",
          "#202836",
          "#263244",
          "#2e3c50",
          "#253040",
          "#e8ebf1",
          "#bcc4d0",
          "#828d9c",
          "#5a6472",
          "#14161a",
          "#6b4a00",
          "#4a3305",
          "transparent",
          "inherit",
          "initial",
          "unset",
          "currentColor",
          "none"
        ],
        "ignoreFunctions": true,
        "expandShorthand": false
      }
    ],
    "color-no-invalid-hex": true,
    "declaration-block-no-duplicate-properties": [
      true,
      {
        "ignore": [
          "consecutive-duplicates-with-different-values"
        ]
      }
    ],
    "block-no-empty": true,
    "no-duplicate-selectors": true,
    "property-no-unknown": true,
    "selector-pseudo-class-no-unknown": true,
    "selector-pseudo-element-no-unknown": true
  },
  "ignoreFiles": [
    "**/vendor/**",
    "**/tokens.css",
    "**/node_modules/**"
  ]
}
