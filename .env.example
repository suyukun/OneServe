# OneServe M0 骨架环境变量（task-002）——复制为 .env 使用：cp .env.example .env
# 仅本机开发占位值；真实密钥不进代码仓（AGENTS.md 安全红线）。

# 调用方 AppKey（APISIX key-auth 凭证；up.sh 会注册为 consumer oneserve-demo）
APISIX_APPKEY=oneserve-dev-appkey-001

# 2026-10-14：管理令牌闸已第三次反转拆除（维护者 拍板，见 docs/adr/0010）——后端
# _admin_gate 恒放行，/v1/admin/* 不再校验 X-Admin-Token，下行注释停用（值真源
# service/app/dev_token.py 保留，恢复闸期复用）。恢复闸时取消下行注释改值即可
# （缺省 admin321）。
#ADMIN_API_TOKEN=admin321

# ── 凭证件（2026-10-20 密钥出库批：compose/configs 零明文凭据，全部改 ${VAR} 环境引用；
#    无登录模式决策 起登录链凭证键全部移除，仅存 APISIX 一件）──
# 以下值为 compose 必填（缺失＝起栈失败并明确提示）；本模板放本机开发占位值；
# 公司/生产环境必须改值（只改副本 .env，真值永不进仓）。
# APISIX Admin API key（configs/apisix/config*.yaml 的 ${{APISIX_ADMIN_KEY}} 同源）
APISIX_ADMIN_KEY=CHANGE_ME_APISIX_ADMIN_KEY

# ── 元数据库六变量（卡-1b7 步1~2 · ADR-0021 v1.1）：oneserve-metadata-db ──
# 前三件＝实例引导三件套（compose.metadata.yml 必填，缺失＝起栈失败并明确提示）；
# 后三件＝三角色口令（meta_app 读写无 DDL／meta_ro 只读对账／meta_migrate DDL 迁移，仅迁移窗口启用）。
# 引导超户仅作 initdb 初始化，业务库不授权超户直连（psql 直改暗道已封，详 init 脚本头注）。
# 本模板放本机开发占位值；真实口令不进代码仓（AGENTS.md 安全红线），只改副本 .env。
META_DB_USER=meta_admin
META_DB_PASSWORD=CHANGE_ME_META_ADMIN_PASSWORD
META_DB_NAME=oneserve_meta
META_APP_PASSWORD=CHANGE_ME_META_APP_PASSWORD
META_RO_PASSWORD=CHANGE_ME_META_RO_PASSWORD
META_MIGRATE_PASSWORD=CHANGE_ME_META_MIGRATE_PASSWORD

# 写侧双模开关（卡-1b7 步5 · META_WRITER=yaml|db）：缺省 yaml＝写侧走既有权威源
# yaml 文件（行为与抽层前逐字节一致）；db＝写 meta 库＋事务内台账同发（步 6 前置落地，
# 当前 db 分支为骨架 NotImplementedError）。宿主机直跑服务/单测不设即 yaml。
#META_WRITER=yaml

# ── 部署地址参数化（2026-10-20 ECS 快验批）──
# PROD_PUBLIC_ORIGIN：浏览器可达的部署地址（如 http://<ECS_IP>:20000）——ECS/prod
# 形态部署必设。无登录模式不依赖本变量派生登录地址；历史派生口径见 git 史。
# 缺省 http://localhost:8000＝dev 本机口径（不设＝行为与历史一致）。
#PROD_PUBLIC_ORIGIN=http://localhost:8000
# PROD_BIND_IP：prod 形态宿主端口绑定地址（compose.prod.yml 的 20080/20000/20443），
# 缺省 127.0.0.1（仅本机回环安全）；ECS 外部机器访问设 0.0.0.0（务必配合安全组白名单）。
#PROD_BIND_IP=127.0.0.1
# ONESERVE_NET_NAME / ONESERVE_NET_EXTERNAL：hbase/kafka 叠加件网络参数（compose.hbase.yml、
# compose.kafka.yml）。dev 不设＝缺省 external oneserve-net（行为与历史一致）；ECS 全量档
# 四文件叠加（-f×4 -p oneserve-prod）必设下面两值，否则叠加件把 prod 专属网覆盖成 external
# oneserve-net（干净环境报 external network not found）。
#ONESERVE_NET_NAME=oneserve-prod-net
#ONESERVE_NET_EXTERNAL=false

# 【无登录模式决策·已删段】登录链路环境变量随开源版拆除人机登录一并移除：
# AUTH_OIDC_MODE / OIDC_ISSUER / OIDC_CLIENT_ID / AUTH_PROVIDER / ONESERVE_AUTH_SECRET /
# ONESERVE_SEED_ADMIN_* / ONESERVE_BOOTSTRAP_ADMIN_*（历史键清单见 git 史）。
# 门户与管理台公开可访；机器调用方仍走网关 AppKey 鉴权（APISIX_APPKEY/ONESERVE_APPKEY）。

# 沙箱凭证有效期天数（P0-4 / SPEC D8：7 天起步，可配）
SB_TTL_DAYS=7

# 凭证轮换重叠期天数（P1-4 / SPEC D8：新旧 key 并行天数，默认 7＝对齐 Stripe 官方上限，可配）
ROTATION_OVERLAP_DAYS=7

# 批量查询配额三口径（M15-5 / NC-4 静态起步值；超限提交端 429，注释掉即用默认）
# BATCH_MAX_KEYS_PER_JOB=1000000      # 单任务键上限（超限 413 too_many_keys）
# BATCH_MAX_CONCURRENT_JOBS=1         # 每租户执行中任务上限（超限 429 quota_concurrent_exceeded）
# BATCH_MAX_DAILY_KEYS=5000000        # 每租户日键量上限（东八区日界清零；超限 429 quota_daily_exceeded）

# HBase 连接（卡1 配置/密钥双轨，2026-09-30）：非敏感参数（host/port/auth_mode/user/
# principal）默认走 config/connections.yaml（进仓、每键带注释）——不再默认从这里注入。
# 本节环境变量**优先级更高**（装配链 env > yaml > 默认，见 service/app/connections.py），
# 需要覆盖时取消注释改值：容器网内默认 oneserve-hbase:9090；宿主机自测（不经容器）
# 指向 127.0.0.1:9090（compose.hbase.yml 已映射宿主 9090）。
#HBASE_HOST=oneserve-hbase
#HBASE_PORT=9090
#HBASE_AUTH_MODE=none            # none | basic | kerberos | tls
#HBASE_USER=                     # basic 用户名（auth_mode=basic 必填）
#HBASE_PRINCIPAL=                # kerberos 主体（auth_mode=kerberos 必填）
#
# 密钥类（密码/keytab/CA 内容）**永不落仓**：只经密钥文件注入，这里与
# connections.yaml 的 secret_file 同款口径——只给**路径引用**，值由开发态手工放置或
# 生产态 K8s Secret/Vault 挂到该路径。
#HBASE_SECRET_FILE=/run/secrets/hbase-pass


# 快照导出目录（卡-1b7 步6）：META_WRITER=db 时写库事务提交后全量导出四 yaml；
# 缺省 ./metadata-snapshots（仓内本地开发回落；生产＝独立可写卷 META_SNAPSHOT_DIR 挂载点）。
#META_SNAPSHOT_DIR=./metadata-snapshots
